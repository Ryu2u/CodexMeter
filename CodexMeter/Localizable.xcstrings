    "backup.restart": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History collection is paused. Quit and reopen CodexMeter to use the restored history. Your current retention setting will apply after reopening."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录已暂停写入。请退出并重新打开 CodexMeter，以使用恢复的历史。重新打开后将应用当前的历史保留期限设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史記錄已暫停寫入。請結束並重新開啟 CodexMeter，以使用還原的歷史。重新開啟後將套用目前的歷史保留期限設定。"
          }
        }
      }
    },
