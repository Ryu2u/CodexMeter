    "backup.failed": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not complete the operation. Check file access and free space. Restore requires a valid backup from a supported CodexMeter version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未完成。请检查文件权限与可用空间。恢复需要使用受支持版本生成的有效 CodexMeter 备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未完成。請檢查檔案權限與可用空間。還原需要使用受支援版本產生的有效 CodexMeter 備份。"
          }
        }
      }
    },
