    "developer.history_preview_help": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a separate Preview weekly window so chart ranges, resets, and estimates can be tested immediately. It does not change live quota or notifications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个独立的“预览周额度”窗口，用于立即测试图表范围、重置边界和估算，不会更改实时额度或触发通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入一個獨立的「預覽週額度」視窗，用於立即測試圖表範圍、重置邊界和估算，不會更改即時額度或觸發通知。"
          }
        }
      }
    },
