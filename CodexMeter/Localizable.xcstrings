    "about.privacy_description": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex quota comes from an explicit device-code sign-in. Only the OAuth refresh credential is stored, and it lives in CodexMeter's own Keychain; access tokens stay in memory and are never written to disk, and no local usage database is kept. Optional external connections query the selected platform directly and keep their API keys in macOS Keychain. No inference traffic is proxied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 额度来自显式的设备码登录。只有 OAuth 刷新凭据会保存下来，存放在 CodexMeter 自己的钥匙串中；访问令牌只保留在内存里，不会写入磁盘，也不再保留本地使用数据库。可选的外部连接直接查询所选平台，API Key 保存在 macOS 钥匙串中，不代理推理流量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 額度來自明確的裝置碼登入。只有 OAuth 重新整理憑證會保存下來，存放在 CodexMeter 自己的鑰匙圈中；存取權杖只保留在記憶體裡，不會寫入磁碟，也不再保留本機使用資料庫。可選的外部連線直接查詢所選平台，API Key 儲存在 macOS 鑰匙圈中，不代理推理流量。"
          }
        }
      }
    },
