    "providers.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API keys are stored in this app’s macOS Keychain items. Queries go directly to the selected platform’s official usage API. Keys are excluded from history and backups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 保存在本应用的 macOS 钥匙串项目中，额度查询直接发往所选平台的官方接口。历史和备份不包含密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 儲存在本應用程式的 macOS 鑰匙圈項目中，額度查詢直接傳送至所選平台的官方介面。歷史與備份不包含金鑰。"
          }
        }
      }
    },
    "providers.query_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queries platform-reported usage only. Token counting, external history and notifications are not enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅查询平台返回的额度与余额，暂不提供新增 Token 计数、外部平台历史或提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅查詢平台回傳的額度與餘額，暫不提供新增 Token 計數、外部平台歷史或提醒。"
          }
        }
